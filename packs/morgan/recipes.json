{
  "recipes_version": 1,
  "pack_id": "morgan",
  "description": "Composable tone recipes, one layer at a time. A preset is built by stacking layers - amp + compressor + drive + eq + cab + delay + reverb - then adapting the values to the actual song. These are starting points to adjust, not answers to ship unchanged.",
  "translated_from": "docs/morgan-config-reference.md",
  "conversion": {
    "knob_scale": "the source doc uses a 0-10 knob scale; every knob value here is that number x10, as percent of rotation",
    "renames": "od1 -> drive1, od2 -> drive2, comp -> compressorCompression, delay/reverb hpfHz -> *LowCut, lpfHz -> *HighCut, eq bandsDb.hzNNN -> *EQBand1..9 ascending",
    "metered": "dB, Hz, ms and seconds pass through unchanged",
    "verification": "tests/test_recipes.py asserts every key exists in the manifest and every value survives translation, so a mis-scaled or mis-named value fails the suite"
  },
  "not_translated": {
    "ac20 powerLevel, standby; sw50r/pr12 power, standby": "no such parameters exist in the file",
    "compressor releaseMode FAST/SLOW": "now known - compressorRelease true is Fast, false is Slow - but recipes still leave it at the template's value because no recipe has a reason to set it",
    "sw50r inputMode DEFAULT/-6_DB": "now known - sw50rInputMode false is the High input, true is the padded Low one - but no recipe needs to change input jacks",
    "ac20 bassCut": "now known - ac20BassTreble is the Bass Cut voicing switch, true selects Treble - but it is a per-guitar taste choice, so recipes leave it alone",
    "cab micId MIC_1..MIC_6": "six abstract ids that do not map onto this plugin's ten named mics; mic choices in the cab recipes are substituted by standard practice",
    "cab pan L25/R25": "now expressible - *CabPan is a signed number, so L25 is -25 and R25 is 25 - but the cab recipes leave the stock centred pair alone",
    "delay/tremolo syncMode and timeNote": "expressed instead as ms and Hz computed from tempo, which needs no selector - see packs/timing.py. The selector tables are now known if a recipe ever needs host-tempo sync.",
    "guitarNotes (section 19)": "playing advice, not plugin parameters; kept in tone.md instead"
  },
