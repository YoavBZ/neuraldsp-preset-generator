# Project-local command policy. Loaded only for this trusted repository.
#
# Important: `decision = "allow"` means the command may run OUTSIDE the sandbox.
# Therefore the allowlist is intentionally small. Normal file reads, edits, tests,
# and project scripts should stay inside workspace-write and need no rule at all.
# User-reviewed prompts are cheap because `.codex/config.toml` disables the
# auto-review subagent for this project.

# Local staging is reversible and cannot transmit data off the machine.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Stage changes in the local project index",
    match = ["git add README.md", "git add -A"],
    not_match = ["git commit -m message"],
)

# Read the configured project's remote refs. This cannot update local refs.
prefix_rule(
    pattern = ["git", "ls-remote", "origin"],
    decision = "allow",
    justification = "Read refs from the already-configured project origin",
    match = ["git ls-remote origin", "git ls-remote origin refs/heads/main"],
    not_match = ["git ls-remote https://example.com/repository.git"],
)

# GitHub network reads. These prefixes do not accept host-file inputs or display
# credentials. `gh auth status` is deliberately omitted because `--show-token`
# would expose the GitHub token.
prefix_rule(
    pattern = ["gh", "pr", ["view", "checks", "list"]],
    decision = "allow",
    justification = "Read pull-request state and CI results",
    match = ["gh pr view 37", "gh pr checks 37 --watch", "gh pr list"],
    not_match = ["gh pr create --title change", "gh pr merge 37"],
)
prefix_rule(
    pattern = ["gh", "run", ["view", "watch", "list"]],
    decision = "allow",
    justification = "Read GitHub Actions state and logs",
)

# Remote writes always remain user-reviewed. A broad prompt rule is safer than
# trying to carve feature branches out of `git push`: Git refspecs can encode main
# updates, force and deletion (`HEAD:main`, `+HEAD:main`, `:main`) without putting a
# dangerous option at a fixed argument position.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Confirm the exact remote and refspec before any push",
)
prefix_rule(
    pattern = ["git", "fetch"],
    decision = "prompt",
    justification = "Fetching mutates local refs and accepts arbitrary refspecs",
)
prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "merge", "close", "reopen", "ready", "review"]],
    decision = "prompt",
    justification = "GitHub pull-request writes require user review; merge also requires fresh-context code review",
)
prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "GitHub API calls can read credentials, upload files, or mutate remote state",
)

# Local repository mutations remain prompts. Broad allow rules for these commands
# are unsafe because options can move (`git commit -a --amend`) or encode destructive
# behavior (`git switch -C`, forced refspecs). The sandbox still permits ordinary
# read-only Git commands without asking.
prefix_rule(
    pattern = ["git", ["commit", "switch", "checkout", "merge", "rebase", "reset", "clean", "stash", "branch", "worktree", "tag"]],
    decision = "prompt",
    justification = "Confirm local history, branch, worktree, or destructive mutations",
)

# Dependency installs and project commands that are expensive, invoke licensed
# plugins, or write output/state remain user-reviewed. Ordinary pytest and Python
# commands are intentionally NOT allowlisted: they execute project-controlled code
# and should remain inside the workspace sandbox.
prefix_rule(
    pattern = [["pip", "pip3", ".venv/bin/pip"], "install"],
    decision = "prompt",
    justification = "Dependency installation changes the environment and may download code",
)
prefix_rule(
    pattern = ["python", "-m", "pip", "install"],
    decision = "prompt",
    justification = "Dependency installation changes the environment and may download code",
)
prefix_rule(
    pattern = ["python3", "-m", "pip", "install"],
    decision = "prompt",
    justification = "Dependency installation changes the environment and may download code",
)
prefix_rule(
    pattern = [".venv/bin/python", ["scripts/benchmark_match.py", "scripts/match_preset.py", "scripts/apply_spec.py", "scripts/measure_eq_basis.py", "scripts/measure_drive_curve.py", "scripts/build_response_atlas.py", "scripts/benchmark_warm_start.py", "scripts/build_observed.py", "scripts/bootstrap_pack.py"]],
    decision = "prompt",
    justification = "This command can spend significant plugin time or write project/output state",
)
prefix_rule(
    pattern = ["auval", "-v"],
    decision = "prompt",
    justification = "Audio Unit validation executes an installed third-party plugin",
)

# Common destructive spellings are blocked outright. This is defense in depth, not
# an exhaustive parser: unmatched spellings still remain constrained by the
# workspace sandbox and the agent's destructive-action policy.
prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-fR"]],
    decision = "forbidden",
    justification = "Use a scoped recoverable deletion or ask the user for a specific target",
)
prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"], ["-f", "--force"]],
    decision = "forbidden",
    justification = "Use a scoped recoverable deletion or ask the user for a specific target",
)
prefix_rule(
    pattern = ["rm", ["-f", "--force"], ["-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "Use a scoped recoverable deletion or ask the user for a specific target",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Preserve the user's worktree; use a non-destructive restore",
)
prefix_rule(
    pattern = ["git", "reset", ["-q", "--quiet"], "--hard"],
    decision = "forbidden",
    justification = "Preserve the user's worktree; use a non-destructive restore",
)

# Safe policy inspection itself.
prefix_rule(
    pattern = ["codex", "execpolicy", "check"],
    decision = "allow",
    justification = "Validate this project's command policy",
)
